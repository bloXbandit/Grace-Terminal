# GRACEai Environment Configuration
# Copy this file to .env and fill in your values

# Database Configuration
DATABASE_URL=sqlite:./grace.db

# Workspace Configuration
WORKSPACE_DIR=workspace

# AI Model Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# GrapesJS Studio SDK License Key
# Get your free license key at: https://app.grapesjs.com/dashboard/sdk/licenses
# Required for visual HTML editor functionality
VITE_GRAPEJS_API_KEY=your_grapesjs_license_key_here

# Application Configuration
NODE_ENV=development
PORT=3000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:3000
